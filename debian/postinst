#!/bin/bash
# debian/postinst — omp-web
#
# Fresh install / resumed-after-interruption (completion marker absent):
# creates the joysort account if absent (never $SUDO_USER — Design
# decision 10), resolves/installs omp, writes the unit + env file (with a
# freshly generated per-machine web password) + ~/.omp/agent seeds (every
# sub-step idempotent, so a resumed interrupted install converges safely
# instead of erroring or duplicating state — Design decision 9), enables
# the service, hands joysortmain its own omp-web administrator if that
# service is co-installed, then writes the completion marker as the LAST
# step via mktemp+mv (atomic rename).
#
# Upgrade/reinstall (marker present): NEVER touches the unit, env file, or
# anything under ~/.omp/agent/. Only overlays /opt/omp-web/current onto
# ~/omp/ompweb via a non-destructive tar-pipe, refreshes bundled runtimes
# if stale, restarts the service if it was running (restart interrupting a
# live in-process AgentSession is accepted — Design decision 12), and
# creates/refreshes a PATH drop-in only if the existing unit's PATH does
# not already cover the resolved omp directory (Design decision 11).
set -e

ROOT_PREFIX="${OMP_WEB_TEST_ROOT:-}"
OMP_WEB_SRC="${ROOT_PREFIX}/opt/omp-web/current"
RUNTIME_DIR="${ROOT_PREFIX}/opt/omp-web/runtime"
CONFIG_DIR="${ROOT_PREFIX}/opt/omp-web/config"
SYSTEMD_SEED="${ROOT_PREFIX}/opt/omp-web/systemd/omp-web.service"

resolve_target_user() {
  if [ -n "${OMP_WEB_TARGET_USER:-}" ]; then
    echo "$OMP_WEB_TARGET_USER"
  else
    echo joysort
  fi
}

case "$1" in
  configure)
    TARGET_USER="$(resolve_target_user)"

    if ! getent passwd "$TARGET_USER" >/dev/null 2>&1; then
      echo "omp-web: account '$TARGET_USER' does not exist; creating it (unconditional fresh-install default, never \$SUDO_USER — Design decision 10)" >&2
      useradd -m -s /bin/bash "$TARGET_USER"
      loginctl enable-linger "$TARGET_USER" 2>/dev/null || true
    fi

    TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
    if [ -z "$TARGET_HOME" ] || [ ! -d "$TARGET_HOME" ]; then
      echo "omp-web: no home directory for user $TARGET_USER after creation" >&2
      exit 1
    fi
    TARGET_UID="$(id -u "$TARGET_USER")"

    # `runuser -l` does not always populate $XDG_RUNTIME_DIR (PAM/systemd
    # differences across hosts), and `systemctl --user` needs it to find the
    # user's private systemd socket. Export it explicitly so every `&&`-chained
    # sub-command inherits it — without this, an upgrade on a pre-existing
    # user (legacy manual deployment) fails with "DBUS_SESSION_BUS_ADDRESS and
    # XDG_RUNTIME_DIR not defined".
    run_as_target() {
      runuser -l "$TARGET_USER" -c "export XDG_RUNTIME_DIR=/run/user/$TARGET_UID; $1"
    }

    MARKER_DIR="$TARGET_HOME/.local/state/omp-web"
    MARKER="$MARKER_DIR/install.complete"
    UNIT_PATH="$TARGET_HOME/.config/systemd/user/omp-web.service"
    DEST="$TARGET_HOME/omp/ompweb"
    DROPIN_DIR="$TARGET_HOME/.config/systemd/user/omp-web.service.d"
    DROPIN="$DROPIN_DIR/10-omp-path.conf"

    sync_bun() {
      BUN_BIN="$TARGET_HOME/.bun/bin/bun"
      if [ ! -x "$BUN_BIN" ]; then
        install -D -m 0755 -o "$TARGET_USER" -g "$TARGET_USER" \
          "$RUNTIME_DIR/bun" "$BUN_BIN"
        # install -D creates the intermediate ~/.bun dirs as root; chown
        # them so the target user owns its own bun install dir (self-update,
        # future installs, and service-invoked bun all need write access).
        chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.bun"
        echo "omp-web: installed bun $(cat "$RUNTIME_DIR/bun.version") at $BUN_BIN" >&2
      fi
    }

    # Resolves omp on the target user's full login PATH (not one hardcoded
    # location, per addendum §8: "using ... that user's full effective
    # login PATH"). Found -> leave it alone, return its directory. Absent
    # -> install the bundled binary to ~/.local/bin (postinst only) and
    # return that directory.
    resolve_or_install_omp() {
      local found_path found_dir
      found_path="$(run_as_target 'command -v omp' 2>/dev/null || true)"
      if [ -n "$found_path" ]; then
        found_dir="$(dirname "$found_path")"
        echo "omp-web: found existing omp at $found_path (preserved, not overwritten)" >&2
        echo "$found_dir"
        return 0
      fi
      local omp_bin="$TARGET_HOME/.local/bin/omp"
      install -D -m 0755 -o "$TARGET_USER" -g "$TARGET_USER" \
        "$RUNTIME_DIR/omp" "$omp_bin"
      # install -D creates ~/.local and ~/.local/bin as root; chown the
      # tree so the target user owns its own local bin dir.
      chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.local"
      echo "omp-web: installed bundled omp $(cat "$RUNTIME_DIR/omp.version") at $omp_bin" >&2
      echo "$TARGET_HOME/.local/bin"
    }

    # bun.lock-hash-keyed shared dependency install (refs #43): the
    # package no longer ships node_modules (2.2GB) or .next/cache (590MB,
    # pure build cache `next start` never reads) to keep the .deb small.
    # Instead this materializes node_modules once per distinct bun.lock
    # under a shared ~/omp/envs/<hash> directory and symlinks it into
    # $DEST — an upgrade whose bun.lock is unchanged from the currently
    # installed release reuses the existing env dir and skips `bun
    # install` entirely. A release with a different bun.lock gets its own
    # env dir, so nothing already-materialized is ever mutated or removed
    # out from under a still-running older release.
    ensure_env() {
      local env_hash env_dir
      env_hash="$(sha256sum "$OMP_WEB_SRC/bun.lock" | cut -c1-16)"
      env_dir="$TARGET_HOME/omp/envs/$env_hash"

      if [ ! -d "$env_dir/node_modules" ]; then
        echo "omp-web: materializing dependencies for bun.lock $env_hash at $env_dir" >&2
        mkdir -p "$env_dir"
        chown "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/omp/envs" "$env_dir"
        cp "$OMP_WEB_SRC/package.json" "$OMP_WEB_SRC/bun.lock" "$env_dir/"
        chown "$TARGET_USER:$TARGET_USER" "$env_dir/package.json" "$env_dir/bun.lock"
        # bun.lock's patchedDependencies (if any) reference patch files by a
        # path relative to the install cwd, e.g.
        # "patches/@scope%2Fpkg@1.0.0.patch" — copy the package's patches/
        # dir (if it ships one) alongside package.json/bun.lock so `bun
        # install` below can resolve it. Without this, `bun install
        # --frozen-lockfile` fails with "Couldn't find patch file" on every
        # currently-deployed host's first run of ensure_env.
        if [ -d "$OMP_WEB_SRC/patches" ]; then
          cp -r "$OMP_WEB_SRC/patches" "$env_dir/"
          chown -R "$TARGET_USER:$TARGET_USER" "$env_dir/patches"
        fi
        run_as_target "cd '$env_dir' && '$TARGET_HOME/.bun/bin/bun' install --frozen-lockfile --production"
      else
        echo "omp-web: reusing existing dependencies for bun.lock $env_hash at $env_dir" >&2
      fi

      # A pre-existing REAL (non-symlink) node_modules — the case for
      # every currently-deployed host, which had node_modules tar-overlaid
      # directly before this change — must be removed first: `ln -sfn`
      # targeting an existing real directory does not replace it, it
      # nests the new symlink *inside* it (standard ln/cp
      # destination-is-a-directory semantics; `-f`/`-n` do not change
      # this for a real, non-symlink destination).
      if [ -e "$DEST/node_modules" ] && [ ! -L "$DEST/node_modules" ]; then
        rm -rf "$DEST/node_modules"
      fi
      ln -sfn "$env_dir/node_modules" "$DEST/node_modules"
      chown -h "$TARGET_USER:$TARGET_USER" "$DEST/node_modules"
    }

    sync_app() {
      local was_active=0
      if run_as_target 'systemctl --user is-active --quiet omp-web.service' 2>/dev/null; then
        was_active=1
        run_as_target 'systemctl --user stop omp-web.service'
      fi

      mkdir -p "$DEST"
      chown "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/omp" "$DEST"
      # tar -cf - | tar -xf -: adds/overwrites every file from the new
      # release, never deletes a file the release doesn't ship (unlike
      # `rsync --delete`) — Design decision 5.
      tar -cf - -C "$OMP_WEB_SRC" . \
        | runuser -l "$TARGET_USER" -c "tar -xf - -C '$DEST'"
      # Old hosts may still have a stale .next/cache on disk from a prior
      # full-tree tar-overlay (before this package stopped shipping it) —
      # the overlay above never deletes, so reclaim it explicitly. Pure
      # build cache; `next start` never reads it.
      rm -rf "$DEST/.next/cache"
      ensure_env

      if [ "$was_active" = 1 ]; then
        run_as_target 'systemctl --user daemon-reload && systemctl --user restart omp-web.service'
      fi
    }

    write_fresh_unit() {
      local omp_dir="$1"
      mkdir -p "$TARGET_HOME/.config/systemd/user"
      # mkdir -p runs as root, leaving ~/.config/systemd/user root-owned;
      # systemctl --user enable needs write access there (default.target.wants/).
      chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.config"
      # Same-directory mktemp + mv (atomic rename): a kill mid-write
      # leaves only a stray temp file, never a truncated omp-web.service —
      # so a marker-absent resume never mistakes a corrupt partial unit
      # for "already written".
      local tmp_unit
      tmp_unit="$(mktemp "$TARGET_HOME/.config/systemd/user/.omp-web.service.XXXXXX")"
      sed \
        -e "s|__HOME__|$TARGET_HOME|g" \
        -e "s|^Environment=PATH=.*|Environment=PATH=$TARGET_HOME/.bun/bin:$omp_dir:/usr/local/bin:/usr/bin:/bin|" \
        "$SYSTEMD_SEED" > "$tmp_unit"
      chmod 0644 "$tmp_unit"
      mv "$tmp_unit" "$UNIT_PATH"
      chown "$TARGET_USER:$TARGET_USER" "$UNIT_PATH"
    }

    # Existing unit: NEVER rewritten. If its PATH= line covers neither the
    # bun dir nor the resolved omp dir, create/refresh the drop-in — the
    # only mechanism allowed to fix PATH on an already-deployed host
    # (Design decision 11 / addendum §8).
    ensure_unit_path_covers_omp() {
      local omp_dir="$1"
      local bun_dir="$TARGET_HOME/.bun/bin"
      local unit_path_line
      unit_path_line="$(grep -m1 '^Environment=PATH=' "$UNIT_PATH" 2>/dev/null || true)"
      if printf '%s' "$unit_path_line" | grep -qF "$bun_dir" \
        && { printf '%s' "$unit_path_line" | grep -qF "$omp_dir" \
             || printf '%s' "$unit_path_line" | grep -qF "$TARGET_HOME/.local/bin"; }; then
        return 0
      fi

      local desired
      desired="Environment=PATH=$bun_dir:$omp_dir:/usr/local/bin:/usr/bin:/bin"
      mkdir -p "$DROPIN_DIR"
      local wanted
      wanted="$(printf '[Service]\n%s\n' "$desired")"
      local existing=""
      [ -f "$DROPIN" ] && existing="$(cat "$DROPIN")"
      if [ "$existing" != "$wanted" ]; then
        printf '%s' "$wanted" > "$DROPIN"
        chown -R "$TARGET_USER:$TARGET_USER" "$DROPIN_DIR"
        echo "omp-web: wrote $DROPIN (existing unit's PATH did not cover $omp_dir)" >&2
        run_as_target 'systemctl --user daemon-reload'
        if run_as_target 'systemctl --user is-active --quiet omp-web.service' 2>/dev/null; then
          run_as_target 'systemctl --user restart omp-web.service'
        fi
      fi
    }

    seed_env_file() {
      local env_dir="$TARGET_HOME/omp/ops/env"
      mkdir -p "$env_dir"
      chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/omp"
      local env_file="$env_dir/5010.env"
      if [ ! -f "$env_file" ]; then
        local host_ip
        host_ip="$(run_as_target "hostname -I | awk '{print \$1}'")"
        # Per-machine random web password (#74). The package ships no
        # secret of any kind any more, so a published .deb grants access
        # to nothing and no two machines share a password. token_urlsafe
        # yields 43 chars of [A-Za-z0-9_-], which needs no quoting in an
        # EnvironmentFile.
        local password
        password="$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')"
        # Same-directory mktemp + mv: a kill mid-write leaves only a stray
        # temp file, never a truncated 5010.env — a marker-absent resume
        # never mistakes a half-written env file for "already seeded".
        local tmp_env
        tmp_env="$(mktemp "$env_dir/.5010.env.XXXXXX")"
        {
          echo "OMP_WEB_HOSTNAME=$host_ip"
          echo "OMP_WEB_USERNAME=omp"
          echo "OMP_WEB_PASSWORD=$password"
          echo "OMP_WEB_TERMINALS=1"
        } > "$tmp_env"
        chmod 0600 "$tmp_env"
        mv "$tmp_env" "$env_file"
        chown "$TARGET_USER:$TARGET_USER" "$env_file"
        echo "omp-web: wrote $env_file (OMP_WEB_HOSTNAME=$host_ip)" >&2
      fi
    }

    seed_agent_dir() {
      local agent_dir="$TARGET_HOME/.omp/agent"
      mkdir -p "$agent_dir"
      chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.omp"

      # The agent .env holds provider API keys and is operator-owned: the
      # package no longer seeds a single key into it (#74 — those keys used
      # to travel inside the .deb). Only ever CREATE it when absent; an
      # existing one is never truncated, rewritten, or merged into, because
      # on a deployed host it holds live, possibly just-rotated keys.
      local env_target="$agent_dir/.env"
      [ -f "$env_target" ] || : > "$env_target"
      chmod 0600 "$env_target"
      chown "$TARGET_USER:$TARGET_USER" "$env_target"

      [ -f "$agent_dir/models.yml" ] \
        || install -m 0644 -o "$TARGET_USER" -g "$TARGET_USER" \
             "$CONFIG_DIR/models.yml.default" "$agent_dir/models.yml"
      [ -f "$agent_dir/config.yml" ] \
        || install -m 0644 -o "$TARGET_USER" -g "$TARGET_USER" \
             "$CONFIG_DIR/config.yml.default" "$agent_dir/config.yml"
    }

    # joysortmain bootstrap (#75). A fresh install switches authentication
    # on immediately (OMP_WEB_PASSWORD in 5010.env), and that file lives
    # under $TARGET_HOME — which the joysortmain service user cannot even
    # traverse on a sorting machine (0750 joysort:joysort). joysortmain's
    # own bootstrap (app/core/omp_accounts.py::_ensure_admin) therefore
    # gets 403 "Admin access required" from POST /api/web-users and gives
    # up with `omp_bootstrap_blocked` forever, which is exactly what makes
    # a freshly apt-installed omp-web unusable from the assistant page.
    #
    # This runs at the one moment something legitimately holds both sides:
    # create joysortmain's dedicated administrator over the API using the
    # credential seed_env_file just generated, then hand THAT account — never
    # the omp password — to joysortmain through its own 0600 store.
    #
    # Idempotent: a store that already names an administrator is left
    # completely alone, and an account that already exists on the omp-web
    # side is never reset. Best-effort end to end (`|| true` at the call
    # site): a convenience bridge for a co-installed service must never
    # fail `apt install omp-web`.
    bootstrap_joysortmain() {
      local data_dir="${ROOT_PREFIX}/var/lib/joysortmain"
      local creds_file="$data_dir/omp_credentials.json"

      # The data dir is the ROOT_PREFIX-safe signal (fixture roots never
      # have one, so the tests can never touch a real host's store). The
      # dpkg fallback covers a package installed but not yet started, and
      # is consulted only for a real (unprefixed) install.
      if [ ! -d "$data_dir" ] \
        && { [ -n "$ROOT_PREFIX" ] \
             || ! dpkg-query -W -f='${Status}' joysortmain 2>/dev/null \
                  | grep -q '^install ok installed$'; }; then
        echo "omp-web: joysortmain bootstrap skipped — joysortmain is not on this host ($data_dir absent, package not installed)" >&2
        return 0
      fi

      # The store is written on joysortmain's behalf, so it must end up
      # owned by the joysortmain service user. Prefer whatever is already
      # on disk; a root-owned data dir means joysortmain has not claimed
      # it yet, so fall back to the account itself.
      local owner_uid="" owner_gid=""
      if [ -e "$creds_file" ]; then
        owner_uid="$(stat -c '%u' "$creds_file" 2>/dev/null || true)"
        owner_gid="$(stat -c '%g' "$creds_file" 2>/dev/null || true)"
      elif [ -d "$data_dir" ]; then
        owner_uid="$(stat -c '%u' "$data_dir" 2>/dev/null || true)"
        owner_gid="$(stat -c '%g' "$data_dir" 2>/dev/null || true)"
      fi
      if [ "${owner_uid:-0}" = 0 ]; then
        owner_uid="$(id -u joysortmain 2>/dev/null || true)"
        owner_gid="$(id -g joysortmain 2>/dev/null || true)"
      fi
      if [ -z "$owner_uid" ] || [ -z "$owner_gid" ]; then
        echo "omp-web: joysortmain bootstrap skipped — cannot resolve the joysortmain service user (no joysortmain account, and $data_dir is root-owned)" >&2
        return 0
      fi

      if [ ! -d "$data_dir" ]; then
        mkdir -p "$data_dir"
        chown "$owner_uid:$owner_gid" "$data_dir"
        chmod 0700 "$data_dir"
      fi

      # Everything below is python3 (already a package dependency; curl is
      # not). The omp password is read straight out of the root-only env
      # file inside this process — it never reaches argv, an env var, or a
      # log line.
      if ! OMP_WEB_BOOTSTRAP_ENV_FILE="$TARGET_HOME/omp/ops/env/5010.env" \
           OMP_WEB_BOOTSTRAP_STORE="$creds_file" \
           OMP_WEB_BOOTSTRAP_UID="$owner_uid" \
           OMP_WEB_BOOTSTRAP_GID="$owner_gid" \
           OMP_WEB_BOOTSTRAP_BASE_URL="${OMP_WEB_TEST_BASE_URL:-}" \
           python3 - <<'PY'
import base64
import json
import os
import secrets
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

ENV_FILE = os.environ["OMP_WEB_BOOTSTRAP_ENV_FILE"]
STORE = os.environ["OMP_WEB_BOOTSTRAP_STORE"]
OWNER_UID = int(os.environ["OMP_WEB_BOOTSTRAP_UID"])
OWNER_GID = int(os.environ["OMP_WEB_BOOTSTRAP_GID"])

# The unit pins the service to 5010. OMP_WEB_TEST_BASE_URL is the fixture
# seam (same family as OMP_WEB_TEST_ROOT) so the tests can drive a throwaway
# server instead of whatever is really listening on this host.
BASE_URL = os.environ.get("OMP_WEB_BOOTSTRAP_BASE_URL") or "http://127.0.0.1:5010"
READY_TIMEOUT = 30.0
ADMIN_USERNAME = "joysortmain-admin"
# lib/web-auth.ts pins the Basic-auth identity to this literal name,
# independent of whatever OMP_WEB_USERNAME says.
ENV_ADMIN_USERNAME = "omp"


def note(message):
    # Status only. No password, no key, ever.
    sys.stderr.write("omp-web: " + message + "\n")


def skip(message):
    note("joysortmain bootstrap skipped — " + message)
    raise SystemExit(0)


def read_env_password():
    try:
        handle = open(ENV_FILE, "r", encoding="utf-8", errors="replace")
    except OSError:
        return None
    with handle:
        for raw in handle:
            line = raw.strip()
            if not line.startswith("OMP_WEB_PASSWORD="):
                continue
            value = line[len("OMP_WEB_PASSWORD="):].strip()
            # systemd strips one matching pair of surrounding quotes when it
            # loads an EnvironmentFile, so the in-process password is the
            # unquoted form. Hosts seeded by the retired sealed-secrets path
            # still carry the quoted shape on disk; match systemd exactly.
            if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
                value = value[1:-1]
            return value or None
    return None


def call(method, path, payload, password):
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(BASE_URL + path, data=data, method=method)
    raw = (ENV_ADMIN_USERNAME + ":" + password).encode("utf-8")
    req.add_header("Authorization", "Basic " + base64.b64encode(raw).decode("ascii"))
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        resp = urllib.request.urlopen(req, timeout=10)
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode("utf-8", "replace")
    except Exception as exc:
        return None, type(exc).__name__
    with resp:
        return resp.getcode(), resp.read().decode("utf-8", "replace")


def error_message(body):
    try:
        payload = json.loads(body)
    except Exception:
        return ""
    return str(payload.get("error", "")) if isinstance(payload, dict) else ""


def wait_until_serving():
    # /api/auth/web-me is auth-exempt in proxy.ts, so any HTTP answer at
    # all — including a 401 — proves the app is serving.
    deadline = time.monotonic() + READY_TIMEOUT
    while True:
        try:
            urllib.request.urlopen(BASE_URL + "/api/auth/web-me", timeout=3).close()
            return True
        except urllib.error.HTTPError:
            return True
        except Exception:
            if time.monotonic() >= deadline:
                return False
            time.sleep(1.0)


store = {"version": 1, "admin": None, "users": {}}
if os.path.exists(STORE):
    try:
        with open(STORE, "r", encoding="utf-8") as handle:
            loaded = json.load(handle)
    except Exception as exc:
        skip("%s exists but is not readable JSON (%s); refusing to overwrite it"
             % (STORE, type(exc).__name__))
    if not isinstance(loaded, dict):
        skip("%s does not hold a JSON object; refusing to overwrite it" % STORE)
    store = loaded
    store.setdefault("version", 1)
    store.setdefault("users", {})
    admin = store.get("admin")
    if isinstance(admin, dict) and admin.get("username"):
        note("joysortmain already holds an omp-web administrator credential — left untouched")
        raise SystemExit(0)

password = read_env_password()
if not password:
    skip("no OMP_WEB_PASSWORD in %s" % ENV_FILE)

if not wait_until_serving():
    skip("omp-web did not answer on %s within %ds" % (BASE_URL, int(READY_TIMEOUT)))

admin_password = secrets.token_urlsafe(32)
status, body = call("POST", "/api/web-users", {
    "username": ADMIN_USERNAME,
    "password": admin_password,
    "role": "admin",
    "projects": "*",
}, password)

if status is None:
    skip("omp-web did not answer the create request (%s)" % body)
if status == 400 and "exists" in error_message(body).lower():
    note("omp-web already has an account named '%s' — left untouched, and joysortmain's "
         "credential store was not changed" % ADMIN_USERNAME)
    raise SystemExit(0)
if status != 201:
    skip("omp-web refused to create '%s' (HTTP %s %s)"
         % (ADMIN_USERNAME, status, error_message(body)))

store["admin"] = {
    "username": ADMIN_USERNAME,
    "password": admin_password,
    "created": datetime.now(timezone.utc).isoformat(),
}

try:
    fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(STORE) or ".",
                                    prefix=".omp_credentials.")
    try:
        os.fchmod(fd, 0o600)
        os.fchown(fd, OWNER_UID, OWNER_GID)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(store, handle, indent=2)
            handle.write("\n")
        os.replace(tmp_path, STORE)
    except Exception:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise
except Exception as exc:
    # The account now exists but joysortmain would never learn its password,
    # which is the one state nothing can repair by itself. Undo it so the
    # next install starts clean instead of hitting a permanent conflict.
    call("DELETE", "/api/web-users/" + ADMIN_USERNAME, None, password)
    skip("could not write %s (%s); the '%s' account just created was removed again"
         % (STORE, type(exc).__name__, ADMIN_USERNAME))

note("created the '%s' omp-web administrator and handed its credential to joysortmain via %s"
     % (ADMIN_USERNAME, STORE))
PY
      then
        echo "omp-web: joysortmain bootstrap did not complete — install continues; rerun 'apt install --reinstall omp-web' once the cause is fixed" >&2
      fi
    }

    write_marker() {
      mkdir -p "$MARKER_DIR"
      # mkdir -p runs as root; chown the ~/.local/state tree so the marker
      # dir (and anything the app writes under ~/.local/state later) is
      # owned by the target user.
      chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.local/state"
      local tmp
      tmp="$(mktemp "$MARKER_DIR/.install.complete.XXXXXX")"
      date -u +%FT%TZ > "$tmp"
      mv "$tmp" "$MARKER"
      chown "$TARGET_USER:$TARGET_USER" "$MARKER"
    }

    if [ ! -f "$MARKER" ]; then
      echo "omp-web: no completion marker at $MARKER — running fresh-install-or-resume (every step below is idempotent)" >&2
      sync_bun
      OMP_DIR="$(resolve_or_install_omp)"
      # Seed env/config FIRST, from the package's own /opt/omp-web copy, so
      # the service can always (re)start below. A resume after an interrupted
      # install may find the service still active but the env file missing —
      # syncing the app (and its restart) before re-seeding the env file would
      # fail to start the service.
      seed_env_file
      seed_agent_dir
      if [ -f "$UNIT_PATH" ]; then
        # Interrupted a previous run after the unit was written but before
        # the marker: never overwrite it, same as a normal upgrade would.
        ensure_unit_path_covers_omp "$OMP_DIR"
      else
        write_fresh_unit "$OMP_DIR"
      fi
      sync_app
      run_as_target 'systemctl --user daemon-reload && systemctl --user enable --now omp-web.service'
      # Only reachable with the marker absent, i.e. once per machine. Never
      # allowed to fail the install (see the function's header).
      bootstrap_joysortmain || true
      write_marker
    else
      echo "omp-web: completion marker present — upgrade path (unit/env/agent dir untouched)" >&2
      sync_bun
      OMP_DIR="$(resolve_or_install_omp)"
      sync_app
      ensure_unit_path_covers_omp "$OMP_DIR"
    fi

    sleep 1
    if run_as_target 'systemctl --user is-active --quiet omp-web.service'; then
      echo "omp-web: omp-web.service is active for $TARGET_USER (port 5010)" >&2
    else
      echo "omp-web: omp-web.service is not active; check:" >&2
      echo "  runuser -l $TARGET_USER -c 'systemctl --user status omp-web.service --no-pager'" >&2
    fi
    ;;
esac

exit 0
