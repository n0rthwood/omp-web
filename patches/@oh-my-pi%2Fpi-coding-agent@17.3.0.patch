+	// A secondary top-level session may share the live singleton once it has
+	// proved its deliveries are routable: async job delivery sinks are keyed by
+	// agent id with last-registration-wins (async/job-manager.ts), so two
+	// sessions both defaulting to MAIN_AGENT_ID would silently steal each
+	// other's results — that is what issue #1923 guarded against. A caller that
+	// supplies its own distinct `agentId` (omp-web gives every browser
+	// conversation one) has no such collision, so it gets working `task`/`bash`
+	// async paths instead of a forced sync fallback. Callers that do not set
+	// `agentId` keep the original refuse-async behaviour.
+	const canShareAsyncJobManager =
+		options.parentTaskPrefix !== undefined ||
+		(options.agentId !== undefined && options.agentId !== MAIN_AGENT_ID);
+	const scopedAsyncJobManager =
+		asyncJobManager ?? (canShareAsyncJobManager ? AsyncJobManager.instance() : undefined);
 
